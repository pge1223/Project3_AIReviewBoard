APP_DEBUG=false

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ai_review_board

OPENAI_API_KEY=
GOOGLE_API_KEY=

NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_BUCKET_NAME=

CHROMA_PERSIST_DIR=./chroma_db

# 아이디어 후보의 참신성 발산·비교·보존 규칙. false면 기존 후보 프롬프트로 즉시 롤백.
IDEATION_NOVELTY_PROMPT_ENABLED=true

# 주제 브레인스토밍 — 아이디어 발굴 트렌드 검색(네이버 검색 API). 키 발급:
# https://developers.naver.com (검색 API). 기본 비활성화 — 인증키가 없으면 켜도 동작하지 않음.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
RAG_TREND_ENABLE_NAVER_SEARCH=false

# 재인: 위원 발언 영상(TTS+MuseTalk) 생성 서버 주소 - backend/app/api/routes/media.py가
# 이 값으로 Colab MuseTalk 서버에 연결해 중계한다. Colab 재기동마다 갱신 필요.
MEDIA_SERVICE_WS_URL=

# sherpa_mongo 원시 공고 데이터 export용 (scripts/export_sherpa_raw_data.py)
SHERPA_SSH_HOST=
SHERPA_SSH_USER=
SHERPA_SSH_PASSWORD=
SHERPA_MONGO_USER=
SHERPA_MONGO_PASSWORD=
SHERPA_MONGO_AUTH_SOURCE=admin
SHERPA_MONGO_DB=sherpa_mongo
